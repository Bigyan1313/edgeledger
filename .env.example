# Copy to .env for the Docker Compose stack:  cp .env.example .env
#
# Compose reads .env from this directory automatically and substitutes these
# into compose.yaml. It is gitignored — keep real secrets only there.
#
# This file is for the *containerized* stack. backend/.env.example is the
# separate, equivalent file for running the API directly on your machine.

# --- Postgres -------------------------------------------------------------
# Used to initialize the database on first boot AND to build the API's
# DATABASE_URL. Changing USER/DB after the volume exists has no effect: those
# only apply when the data directory is empty. Start over with
#   docker compose down -v
POSTGRES_USER=edgeledger
POSTGRES_DB=edgeledger

# Required — Compose refuses to start without it.
# Avoid @ : / ? # in the password, or URL-encode them: the value is
# interpolated into a postgresql:// connection string, and those characters
# are URL syntax.
POSTGRES_PASSWORD=change-me-for-local-dev

# --- API ------------------------------------------------------------------
# Required. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value in production. Changing it invalidates every issued
# login token.
JWT_SECRET=replace-with-a-long-random-string

# Optional. Without these, Google sign-in and screenshot import stay disabled;
# the rest of the app works.
GOOGLE_CLIENT_ID=
ANTHROPIC_API_KEY=

# Comma-separated browser origins allowed to call the API. The default covers
# Vite's dev ports.
# FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Host ports -----------------------------------------------------------
# Change these if something already listens on your machine — a local Postgres
# on 5432 is the usual collision.
# API_PORT=3001
# POSTGRES_PORT=5432
# ADMINER_PORT=8080
