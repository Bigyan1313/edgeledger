generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String? // optional: Google-only users have no password
  googleId     String?   @unique // Google's stable user id (the "sub" claim)
  displayName  String?
  createdAt    DateTime  @default(now())
  trades       Trade[]
  accounts     Account[]
  profile      Profile?
  sessions     TradingSession[]
  reviews      PriceActionReview[]
}

// The trader behind the journal, and the defaults that make logging faster.
//
// Kept out of User on purpose: User is identity and authentication, and this is
// preference data that changes for different reasons and on a different
// schedule. Every field is optional — a profile is something you fill in over
// time, and an unset default must stay distinguishable from a chosen one, the
// same rule the trade model follows.
model Profile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Shown around the app instead of the email address.
  displayName String?

  // The IANA zone stamped onto captureTimezone at entry. Detected from the
  // browser when unset; stored here so a trader who travels can pin the zone
  // their journal should be read in.
  timezone String?

  // What the P&L column is denominated in. Display only — nothing is converted,
  // because a converted figure is a derived number the journal did not witness.
  baseCurrency String?

  // Stage A defaults. These exist to cut typing: the platform and broker account
  // are the same on nearly every trade, and retyping them is exactly the friction
  // that stops journals getting filled in.
  defaultBrokerPlatform  String?
  defaultBrokerAccountId String?

  // Seeds the position-size calculator.
  defaultRiskPercent Float?

  // The trader's own floor for the pre-session readiness check. Unset means the
  // app's default applies — and each session records the floor it was actually
  // judged against, so this can change without rewriting what past days meant.
  minSleepHours Float?

  // When the trader's market opens, as a wall-clock time in the market's own
  // zone. The price action review opens three hours after this. Unset means
  // the New York cash open (09:30 America/New_York); each review records the
  // open it was written against, as sessions record their sleep floor.
  marketOpenTime String? // "HH:MM"
  marketTimezone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  mode            String // "Live" | "Demo"
  propFirm        String? // for Demo accounts: prop firm name (null = plain practice / N/A)
  startingBalance Float?

  // The firm's rules for losing the account, as the trader enters them. All
  // optional: an account without rules simply shows no distance-to-losing,
  // rather than one computed from limits nobody set.
  dailyLossLimit      Float? // dollars from the day's start
  maxDrawdown         Float? // dollars from the floor's reference point
  drawdownType        String? // static | eod_trailing | intraday_trailing
  drawdownLockBalance Float? // a trailing floor stops rising at this balance

  createdAt       DateTime @default(now())
  trades          Trade[]
  sessions        TradingSession[]
}

// Schema v2. Two conventions run through this model:
//
//  1. Columns that v2 requires are still nullable at the database level. The
//     44 v1 rows genuinely lack them and must survive migration (Task 8), so
//     requiredness is enforced in src/domain/validation.js — which is also the
//     only layer that can return the specific message each rule owes the user.
//     schemaVersion tells the two populations apart.
//
//  2. No boolean or enum column carries a default. A defaulted field is worse
//     than an empty one: it looks like a recorded observation when nobody
//     observed anything. v1 proved it — emotionBefore was "Calm" on all 44
//     rows and fullPort was false on all 44, carrying zero information each.
model Trade {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId Int?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Task 8 — which contract this row was written under. 1 = pre-v2 legacy.
  schemaVersion Int @default(2)

  // Task 1 — broker linkage. The join key to execution data; without it the
  // journal and the broker's records are two unrelated datasets.
  brokerPositionId String?
  brokerAccountId  String?
  brokerPlatform   String? // cTrader | MT4 | MT5 | other

  // Task 6 — unambiguous UTC. `entryTimeUtc` replaces v1's `date`, whose Z
  // suffix could not be trusted to mean true UTC. captureTimezone records the
  // IANA zone the user was in, so local-time questions stay answerable
  // without making the stored instant ambiguous.
  entryTimeUtc    DateTime
  exitTimeUtc     DateTime?
  captureTimezone String?

  // Task 6 — the broker's exact symbol string (e.g. "XAUUSD.pro"), so it joins
  // to execution data without a mapping table.
  pair      String
  direction String // long | short

  // Task 3 — two orthogonal axes. v1's single `setup` enum mixed chart
  // structure with trader state, so a revenge trade on a break & retest had to
  // discard one of the two facts.
  technicalSetup String?
  emotionalState String?

  // The v1 `setup` string, kept verbatim. The migration projects it onto
  // whichever of the two axes it actually described and leaves the other NULL,
  // because the other genuinely was not recorded. This column is what makes
  // that projection reversible instead of lossy. v2 never writes it.
  legacySetup String?

  // Task 5 — required in v2 and validated: lot > 0, stop > 0, stop on the
  // losing side of entry.
  entryPrice Float?
  stopLoss   Float?
  takeProfit Float?
  exitPrice  Float?
  lotSize    Float?

  // Legacy v1 column only. v2 never writes it — riskDollars is computed from
  // entry, stop, lot size and contract size (src/domain/derived.js) so it
  // cannot disagree with the numbers it is supposed to summarise. Kept so the
  // v1 rows that do carry a user-entered figure keep it.
  riskDollars Float?

  // Nullable because a Stage A trade has been entered but not yet exited.
  pnl Float?

  // Task 4 — both are wired to real controls in the entry UI, so they survive;
  // what does not survive is their default. v1's `emotionBefore` is gone,
  // superseded by emotionalState.
  followedChecklist Boolean?
  fullPort          Boolean?

  notes      String? // pre-trade: what you saw, why you took it
  setupNotes String? // free-text about the setup itself (why it qualified)
  exitNotes  String? // post-trade review

  // Chart screenshots, stored as compressed data URLs. Evidence, not a claim:
  // attaching one after the fact is legitimate, so this is never locked.
  screenshots String[] @default([])

  // Task 2 — journaling latency. journaledAt is written once and never
  // updated; lastEditedAt moves on every save after the first. The gap between
  // journaledAt and entryTimeUtc is what exposes retroactive journaling
  // without depending on the user mentioning it in a note.
  journaledAt  DateTime  @default(now())
  lastEditedAt DateTime?

  // Task 7 — two-stage entry. Stage A fields lock on save; changing one
  // requires the amend path, which stamps amendedAt and writes an audit row.
  entryStage String           @default("pending_exit")
  amendedAt  DateTime?
  amendments TradeAmendment[]

  // Task 8 — recomputed on every write. Flags describe, they never repair.
  dataQualityFlags String[] @default([])

  // The session this trade was logged under, and which of its rules were
  // broken at the moment it was logged. Written once at Stage A and never
  // recomputed: unlike a data-quality flag, a broken rule is a fact about
  // the decision, and later edits to the trade cannot un-break it.
  sessionId      Int?
  session        TradingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  ruleViolations String[]        @default([])

  createdAt DateTime @default(now())

  // Task 1 — a position ID identifies one position exactly once. Scoped to the
  // user because broker position IDs are only unique within a broker account:
  // two traders on the same broker can legitimately hold the same ID, and a
  // global constraint would lock the second one out of their own journal
  // forever. Postgres treats NULLs as distinct, so the unlinked v1 rows do not
  // collide with each other.
  @@unique([userId, brokerPositionId])
  @@index([userId, schemaVersion])
}

// Task 7 — the audit trail. One row per field changed per amendment, so
// "what did this trade say when it was first written?" is answerable from the
// data rather than from trust.
model TradeAmendment {
  id        Int      @id @default(autoincrement())
  tradeId   Int
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String? // rendered as text: this is a record, not a working value
  newValue  String?
  reason    String?
  amendedAt DateTime @default(now())

  @@index([tradeId])
}

// A trading day's plan, written before the first trade and locked once written.
//
// This is the same contract as Stage A, one level up: the plan is what you
// committed to while calm, and the point of locking it is that the moment you
// most want to change it is the moment you should not be able to. There is no
// delete and no edit. A session that fails the readiness check is still stored
// — "I wanted to trade on four hours of sleep and was stopped" is the most
// useful row in the table.
model TradingSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId Int?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // The trading day as a local calendar date, and the zone it was computed in.
  // Stored as text because a "day" is not an instant: 9:30 in New York and
  // 9:30 in Kathmandu are the same date in neither UTC nor each other.
  sessionDate String
  timezone    String

  // Readiness. Numbers rather than "do you feel ready?", because the person
  // answering at 9:25 wants to trade and will round up a feeling. An hour
  // count is harder to round up.
  sleepHours           Float
  fitToTrade           Boolean
  minSleepHoursApplied Float

  // The plan. wantToSee is what has to appear before any trade; scenarios are
  // the if/then branches decided in advance; noTradeIf is the condition that
  // ends the day. maxTrades is at most 2, enforced in the API and again by a
  // CHECK constraint. All four are null on a blocked day — nobody should have
  // to write a plan to be told they may not trade — and a CHECK constraint
  // requires them on every day that opened.
  bias      String? // long | short | neutral
  wantToSee String?
  scenarios Json? // [{ "if": string, "then": string }]
  noTradeIf String?
  maxTrades Int?

  // Trades logged under this plan. Only ever incremented: deleting a trade
  // from the journal does not un-take it at the broker, so it must not hand
  // back a slot under the cap.
  tradesLogged Int @default(0)

  // open | blocked | closed. Blocked is decided once, at write time, by the
  // readiness check — and it is final for the day.
  status         String
  blockedReasons String[] @default([])
  openedAt       DateTime @default(now())

  // Post-session review.
  closedAt     DateTime?
  followedPlan Boolean?
  review       String?

  trades    Trade[]
  createdAt DateTime @default(now())

  // One plan per account per day. Postgres treats NULLs as distinct, so the
  // no-account case is enforced in the route rather than here.
  @@unique([userId, accountId, sessionDate])
  @@index([userId, sessionDate])
}

// The day's price action, reviewed once the morning has played out.
//
// Where the session plan is about the trader before the open and the trade is
// about one decision, this is about the market: what price actually did, set
// beside what the plan expected it to do. It can only be written from three
// hours after the open — before that the morning has not happened yet, and a
// "review" written mid-session is commentary on open positions. It is written
// on the day or not at all: a review written tomorrow knows how today ended.
model PriceActionReview {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The trading day in the market's zone — not the trader's. The market
  // defines the day; someone trading the New York open from Asia is still
  // trading New York's Tuesday.
  reviewDate     String
  symbol         String // the broker's exact symbol, as on trades
  marketTimezone String
  marketOpenTime String

  dayType        String // trend_up | trend_down | range | reversal | chop
  summary        String // what price did
  openBehavior   String?
  keyLevels      String?
  liquidityTaken String? // buy_side | sell_side | both | neither

  // Did what the plan wanted to see actually happen? Required when a plan
  // was written for the day; null when there was none to compare against.
  planPlayedOut String? // yes | partly | no

  // Was there a valid setup by the trader's own rules, whether or not it was
  // taken? Separates "the market gave nothing" from "I missed it" and from
  // "I traded something that was not there".
  validSetup Boolean

  lesson      String?
  screenshots String[] @default([])

  writtenAt    DateTime  @default(now())
  lastEditedAt DateTime?

  @@unique([userId, reviewDate, symbol])
  @@index([userId, reviewDate])
}
